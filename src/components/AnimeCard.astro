---
import LinkCard from '~/user-components/LinkCard.astro';
import Badge from '~/user-components/Badge.astro';
import { URLS, STATUS_VARIANT, type Status } from '~/constants';

interface Props {
  anime: {
    id: string;
    data: {
      title: string;
      cover: string;
      status: string;
      type: string;
      releaseDate: Date | null;
      episodes?: { number: number }[];
    };
  };
  featured?: boolean;
  relationBadge?: string;
}

const { anime, featured = false, relationBadge } = Astro.props;
const { id, data } = anime;

const variant = STATUS_VARIANT[data.status as Status] ?? 'default';

const lastEpisode = data.episodes?.length
  ? Math.max(...data.episodes.map(e => e.number))
  : 0;
---

<LinkCard
  href={URLS.anime(id)}
  variant="trans"
  padding="none"
  lift={false}
  class:list={['anime-card', { 'anime-card-featured': featured }]}
>
  <div class="cover">
    <div class="cover-placeholder is-loading" aria-hidden="true"></div>

    <img
      src={data.cover}
      alt={`Cover ${data.title}`}
      width="300"
      height="450"
      loading="lazy"
      decoding="async"
      data-cover-img
    />

    <span class="type-badge">{data.type}</span>

    <div class="status-overlay">
      <Badge variant={variant} size="sm">{data.status}</Badge>
    </div>
  </div>

  <div class="info">
    <h3 set:html={data.title} />

    {relationBadge && (
      <span class="relation-badge">{relationBadge}</span>
    )}

    {lastEpisode > 0 && !relationBadge && (
      <span class="episodes">Ep {lastEpisode}</span>
    )}

    {lastEpisode > 0 && relationBadge && (
      <span class="episodes">
        {relationBadge} · Ep {lastEpisode}
      </span>
    )}
  </div>
</LinkCard>

<script>
  (function () {
    function setupCoverImage(img: HTMLImageElement): void {
      if (img.dataset.ready) return;
      img.dataset.ready = '1';

      const wrap = img.parentElement;
      const placeholder = wrap?.querySelector<HTMLElement>('.cover-placeholder') ?? null;

      const stopShimmer = () => {
        placeholder?.classList.remove('is-loading');
      };

      const done = () => {
        img.classList.add('is-loaded');
        stopShimmer();
      };

      const fail = () => {
        img.hidden = true;
        stopShimmer();
      };

      if (img.complete) {
        if (img.naturalWidth > 0) done();
        else fail();
        return;
      }

      img.addEventListener('load', done, { once: true });
      img.addEventListener('error', fail, { once: true });
    }

    function init(scope: ParentNode = document): void {
      scope
        .querySelectorAll<HTMLImageElement>('[data-cover-img]')
        .forEach(setupCoverImage);
    }

    init();

    window.addEventListener('qimochi:covers', (e) => {
      const detail = (e as CustomEvent<ParentNode>).detail;
      if (detail) init(detail);
    });
  })();
</script>

<style>
  .anime-card {
    display: block;
    min-width: 0;
    text-decoration: none;
    color: inherit;
  }

  .cover {
    position: relative;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    background: var(--bg-surface);
  }

  .cover-placeholder {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--bg-surface);
    pointer-events: none;
  }

  .cover-placeholder.is-loading::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      transparent 20%,
      var(--bg-hover) 50%,
      transparent 80%
    );
    transform: translateX(-100%);
    animation: cover-shimmer 1.6s infinite;
  }

  @keyframes cover-shimmer {
    100% { transform: translateX(100%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .cover-placeholder.is-loading::before {
      animation: none;
      opacity: 0;
    }
  }

  .cover img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    opacity: 0;
    transition: opacity var(--t-base);
  }

  .cover img.is-loaded {
    opacity: 1;
  }

  .cover img[hidden] {
    display: none;
  }

  .anime-card:hover h3::after {
    opacity: 1;
  }

  .cover::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(
      to bottom,
      transparent 50%,
      rgba(0, 0, 0, 0.6) 100%
    );
    pointer-events: none;
  }

  .type-badge {
    position: absolute;
    top: var(--s-2);
    right: var(--s-2);
    z-index: 3;
    display: inline-flex;
    align-items: center;
    padding: 2px 6px;
    background: rgba(0, 0, 0, 0.7);
    color: var(--text-inverted);
    font-size: 0.625rem;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    backdrop-filter: blur(8px);
  }

  .status-overlay {
    position: absolute;
    bottom: var(--s-2);
    left: var(--s-2);
    z-index: 3;
    & span {
      text-transform: uppercase;
    }
  }

  .info {
    padding: var(--s-3) 0 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    min-width: 0;
  }

  .info h3 {
    position: relative;
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    color: var(--text-primary);
    line-height: var(--lh-tight);
    margin: 0;
    min-width: 0;

    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    overflow-wrap: anywhere;
    &::after {
      content: '';
      position: absolute;
      left: -3%;
      right: -3%;
      bottom: -0.1em;
      height: 0.45em;
      background-color: var(--text-primary);
      -webkit-mask-image: var(--underline);
      mask-image: var(--underline);
      -webkit-mask-size: 100% 100%;
      mask-size: 100% 100%;
      -webkit-mask-repeat: no-repeat;
      mask-repeat: no-repeat;
      pointer-events: none;
      opacity: 0;
      transition: opacity var(--t-fast);
    }
  }

  .relation-badge {
    display: inline-block;
    align-self: flex-start;
    padding: 2px 6px;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 0.625rem;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1;
  }

  .episodes {
    font-size: var(--fs-xs);
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
    font-weight: var(--fw-medium);
  }

  .anime-card-featured {
    background: transparent;
  }
</style>