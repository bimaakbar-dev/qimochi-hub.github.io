---
interface Props {
  animeId: string;
}

const { animeId } = Astro.props;
const apiBase = import.meta.env.PUBLIC_API_BASE ?? 'https://api.qimochi.web.id';
---

<div
  class="rating-wrap"
  data-rating-widget
  data-anime={animeId}
  data-api={apiBase}
>
  <div class="rating">
    <span class="rating-stars" data-stars role="radiogroup" aria-label="Rating">
      {[1, 2, 3, 4, 5].map((n) => (
        <button
          type="button"
          class="rating-star"
          data-star={n}
          role="radio"
          aria-checked="false"
          aria-label={`${n} bintang`}
          disabled
        >★</button>
      ))}
    </span>

    <span class="rating-divider" aria-hidden="true">·</span>

    <button type="button" class="rating-score" data-score-btn disabled>
      <span class="rating-average" data-average>—</span>
      <span class="rating-scale">/10</span>
    </button>

    <span class="rating-votes" data-votes></span>

    <span class="rating-user" data-user hidden></span>

    <button
      type="button"
      class="rating-clear"
      data-clear
      hidden
      aria-label="Hapus rating"
    >×</button>
  </div>

  <button
    type="button"
    class="rating-cta"
    data-rating-cta
    hidden
  ></button>

  <div class="rating-dist" data-dist hidden>
    {[5, 4, 3, 2, 1].map((n) => (
      <div class="rating-dist-row">
        <span class="rating-dist-label">{n}★</span>
        <span class="rating-dist-bar">
          <span class="rating-dist-fill" data-fill={n} style="width: 0%"></span>
        </span>
        <span class="rating-dist-count" data-count={n}>0</span>
      </div>
    ))}
  </div>
</div>

<style>
  .rating-wrap {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }

  .rating {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--fs-sm);
    color: var(--text-secondary);
    line-height: 1;
  }

  .rating-stars {
    display: inline-flex;
    align-items: center;
    gap: 1px;
  }

  .rating-star {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    width: 1.125rem;
    height: 1.125rem;
    background: transparent;
    border: none;
    color: var(--border-hover);
    font-size: 1rem;
    line-height: 1;
    cursor: pointer;
    transition: color var(--t-fast);
  }

  .rating-star:disabled {
    cursor: not-allowed;
  }

  .rating-star:not(:disabled):hover {
    color: var(--gold-hover);
  }

  .rating-star.is-active {
    color: var(--gold);
  }

  .rating-star.is-preview {
    color: var(--gold-hover);
  }

  .rating-divider {
    color: var(--text-muted);
    opacity: 0.5;
  }

  .rating-score {
    display: inline-flex;
    align-items: baseline;
    gap: 1px;
    padding: 0;
    background: none;
    border: none;
    font-variant-numeric: tabular-nums;
    color: var(--text-primary);
    font-weight: var(--fw-semibold);
    cursor: pointer;
    font-family: inherit;
  }

  .rating-score:disabled {
    cursor: default;
  }

  .rating-score:not(:disabled):hover .rating-average {
    color: var(--accent);
  }

  .rating-average {
    font-size: var(--fs-base);
  }

  .rating-scale {
    font-size: var(--fs-xs);
    color: var(--text-muted);
    font-weight: var(--fw-normal);
  }

  .rating-votes {
    font-size: var(--fs-xs);
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .rating-votes:empty {
    display: none;
  }

  .rating-user {
    font-size: var(--fs-xs);
    color: var(--accent);
    font-weight: var(--fw-medium);
    font-variant-numeric: tabular-nums;
  }

  .rating-user[hidden] {
    display: none;
  }

  .rating-clear {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1rem;
    height: 1rem;
    padding: 0;
    background: transparent;
    border: none;
    color: var(--text-muted);
    font-size: 0.875rem;
    line-height: 1;
    cursor: pointer;
    transition: color var(--t-fast);
  }

  .rating-clear:hover {
    color: var(--danger);
  }

  .rating-clear[hidden] {
    display: none;
  }

  .rating-cta {
    align-self: flex-start;
    padding: 0;
    background: transparent;
    border: none;
    color: var(--text-muted);
    font-size: var(--fs-xs);
    font-weight: var(--fw-medium);
    line-height: var(--lh-tight);
    text-align: left;
    cursor: pointer;
    transition: color var(--t-fast);
  }

  .rating-cta:hover {
    color: var(--accent);
  }

  .rating-cta[hidden] {
    display: none;
  }

  .rating-dist {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--s-2) 0 0;
    border-top: 1px dashed var(--border);
    max-width: 20rem;
  }

  .rating-dist[hidden] {
    display: none;
  }

  .rating-dist-row {
    display: grid;
    grid-template-columns: 1.75rem 1fr 2rem;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }

  .rating-dist-label {
    font-variant-numeric: tabular-nums;
    text-align: right;
  }

  .rating-dist-bar {
    display: block;
    height: 6px;
    background: var(--bg-surface);
    border-radius: var(--r-sm);
    overflow: hidden;
  }

  .rating-dist-fill {
    display: block;
    height: 100%;
    background: var(--gold);
    transition: width var(--t-base);
  }

  .rating-dist-count {
    font-variant-numeric: tabular-nums;
    text-align: right;
  }
</style>

<script>
  interface AuthUser {
    sub: string;
    name: string;
    email: string;
    picture: string | null;
  }

  (function () {
    const root = document.querySelector<HTMLElement>('[data-rating-widget]');
    if (!root) return;

    const ANIME_ID = root.dataset.anime || '';
    const API = (root.dataset.api || '').replace(/\/$/, '');
    if (!ANIME_ID || !API) return;

    const stars = Array.from(
      root.querySelectorAll<HTMLButtonElement>('[data-star]')
    );
    const scoreBtn = root.querySelector<HTMLButtonElement>('[data-score-btn]')!;
    const averageEl = root.querySelector<HTMLElement>('[data-average]')!;
    const votesEl = root.querySelector<HTMLElement>('[data-votes]')!;
    const userEl = root.querySelector<HTMLElement>('[data-user]')!;
    const clearBtn = root.querySelector<HTMLButtonElement>('[data-clear]')!;
    const ctaBtn = root.querySelector<HTMLButtonElement>('[data-rating-cta]')!;
    const distEl = root.querySelector<HTMLElement>('[data-dist]')!;
    const fills: Record<number, HTMLElement> = {};
    const counts: Record<number, HTMLElement> = {};
    for (let n = 1; n <= 5; n++) {
      fills[n] = root.querySelector<HTMLElement>(`[data-fill="${n}"]`)!;
      counts[n] = root.querySelector<HTMLElement>(`[data-count="${n}"]`)!;
    }

    let userScore: number | null = null;
    let currentUser: AuthUser | null = null;
    let submitting = false;
    let distOpen = false;

    function formatAverage(avg: number): string {
      if (!avg) return '—';
      return avg.toFixed(1);
    }

    function paintStars(active: number | null, preview = false): void {
      for (const s of stars) {
        const n = Number(s.dataset.star);
        s.classList.remove('is-active', 'is-preview');
        if (active !== null && n <= active) {
          s.classList.add(preview ? 'is-preview' : 'is-active');
        }
      }
    }

    function updateAria(): void {
      for (const s of stars) {
        const n = Number(s.dataset.star);
        s.setAttribute('aria-checked', String(n === userScore));
      }
    }

    function updateCta(): void {
      if (!currentUser) {
        ctaBtn.textContent = 'Login atau daftar untuk memberi rating';
        ctaBtn.hidden = false;
        return;
      }
      if (userScore === null) {
        ctaBtn.textContent = 'Beri rating';
        ctaBtn.hidden = false;
        return;
      }
      ctaBtn.hidden = true;
      ctaBtn.textContent = '';
    }

    function setInteractive(): void {
      const canRate = !!currentUser;
      for (const s of stars) s.disabled = !canRate || submitting;
      clearBtn.hidden = !(currentUser && userScore !== null);
    }

    function renderUserScore(): void {
      if (userScore !== null) {
        paintStars(userScore);
        userEl.textContent = `kamu: ${userScore}`;
        userEl.hidden = false;
      } else {
        paintStars(null);
        userEl.hidden = true;
      }
      updateAria();
      updateCta();
    }

    function renderDistribution(dist: Record<number, number>): void {
      let total = 0;
      for (let n = 1; n <= 5; n++) total += dist[n] || 0;

      if (total === 0) {
        distEl.hidden = true;
        return;
      }

      let maxCount = 0;
      for (let n = 1; n <= 5; n++) {
        if (dist[n] > maxCount) maxCount = dist[n];
      }

      for (let n = 1; n <= 5; n++) {
        const c = dist[n] || 0;
        counts[n].textContent = String(c);
        const pct = maxCount > 0 ? (c / maxCount) * 100 : 0;
        fills[n].style.width = `${pct}%`;
      }

      if (distOpen) distEl.hidden = false;
    }

    function toggleDist(): void {
      if (distEl.hidden && !distOpen) {
        distOpen = true;
        const anyCount = [1, 2, 3, 4, 5].some(
          (n) => Number(counts[n].textContent || '0') > 0
        );
        if (anyCount) distEl.hidden = false;
      } else {
        distOpen = false;
        distEl.hidden = true;
      }
    }

    async function fetchRating(): Promise<void> {
      try {
        const res = await fetch(
          `${API}/api/v1/ratings/${encodeURIComponent(ANIME_ID)}`,
          { credentials: 'include' }
        );
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const json = (await res.json()) as {
          data: {
            average: number;
            votes: number;
            userScore: number | null;
            canRate: boolean;
            distribution: Record<number, number>;
          };
        };
        const d = json.data;
        averageEl.textContent = formatAverage(d.average);
        votesEl.textContent = d.votes ? `(${d.votes})` : '';
        userScore = d.userScore;
        renderUserScore();
        setInteractive();
        scoreBtn.disabled = d.votes === 0;
        renderDistribution(d.distribution || {});
      } catch (err) {
        console.error('[rating] fetch failed', err);
        averageEl.textContent = '—';
        votesEl.textContent = '';
        setInteractive();
        updateCta();
        scoreBtn.disabled = true;
      }
    }

    async function submitRating(score: number): Promise<void> {
      if (!currentUser || submitting) return;
      submitting = true;
      setInteractive();

      try {
        const res = await fetch(
          `${API}/api/v1/ratings/${encodeURIComponent(ANIME_ID)}`,
          {
            method: 'POST',
            credentials: 'include',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ score }),
          }
        );

        if (res.status === 401) {
          currentUser = null;
          setInteractive();
          updateCta();
          return;
        }

        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const json = (await res.json()) as {
          data: {
            average: number;
            votes: number;
            userScore: number | null;
            distribution: Record<number, number>;
          };
        };
        const d = json.data;
        averageEl.textContent = formatAverage(d.average);
        votesEl.textContent = d.votes ? `(${d.votes})` : '';
        userScore = d.userScore;
        renderUserScore();
        scoreBtn.disabled = d.votes === 0;
        renderDistribution(d.distribution || {});
      } catch (err) {
        console.error('[rating] submit failed', err);
      } finally {
        submitting = false;
        setInteractive();
      }
    }

    async function clearRating(): Promise<void> {
      if (!currentUser || submitting) return;
      submitting = true;
      setInteractive();

      try {
        const res = await fetch(
          `${API}/api/v1/ratings/${encodeURIComponent(ANIME_ID)}`,
          { method: 'DELETE', credentials: 'include' }
        );

        if (res.status === 401) {
          currentUser = null;
          setInteractive();
          updateCta();
          return;
        }

        if (!res.ok && res.status !== 404) {
          throw new Error(`HTTP ${res.status}`);
        }

        const json = (await res.json()) as {
          data: {
            average: number;
            votes: number;
            userScore: number | null;
            distribution: Record<number, number>;
          };
        };
        const d = json.data;
        averageEl.textContent = formatAverage(d.average);
        votesEl.textContent = d.votes ? `(${d.votes})` : '';
        userScore = null;
        renderUserScore();
        scoreBtn.disabled = d.votes === 0;
        renderDistribution(d.distribution || {});
      } catch (err) {
        console.error('[rating] clear failed', err);
      } finally {
        submitting = false;
        setInteractive();
      }
    }

    for (const s of stars) {
      const n = Number(s.dataset.star);
      s.addEventListener('mouseenter', () => {
        if (!currentUser || submitting) return;
        paintStars(n, true);
      });
      s.addEventListener('mouseleave', () => {
        if (!currentUser || submitting) return;
        paintStars(userScore);
      });
      s.addEventListener('click', () => {
        if (!currentUser || submitting) return;
        submitRating(n);
      });
    }

    clearBtn.addEventListener('click', () => clearRating());

    scoreBtn.addEventListener('click', () => {
      if (scoreBtn.disabled) return;
      toggleDist();
    });

    ctaBtn.addEventListener('click', () => {
      // guest → buka panel login
      if (!currentUser) {
        const menu = (window as any).__qimochiUserMenu;
        if (menu?.open) menu.open();
        return;
      }
      // login, belum vote → fokus ke bintang pertama
      const first = stars[0];
      if (first) first.focus();
    });

    function readCache(): AuthUser | null {
      try {
        const raw = localStorage.getItem('qimochi:user-cache');
        if (!raw) return null;
        const parsed = JSON.parse(raw) as Partial<AuthUser> | null;
        if (
          parsed &&
          typeof parsed.sub === 'string' &&
          typeof parsed.name === 'string'
        ) {
          return {
            sub: parsed.sub,
            name: parsed.name,
            email: typeof parsed.email === 'string' ? parsed.email : '',
            picture:
              typeof parsed.picture === 'string' ? parsed.picture : null,
          };
        }
      } catch {}
      return null;
    }

    function onAuthChanged(e: Event): void {
      const detail = (e as CustomEvent<{ user: AuthUser | null }>).detail;
      if (!detail) return;
      const same =
        (detail.user?.sub ?? null) === (currentUser?.sub ?? null);
      if (same) return;
      currentUser = detail.user;
      if (!currentUser) {
        userScore = null;
        renderUserScore();
      }
      setInteractive();
      fetchRating();
    }

    document.addEventListener('qimochi:auth-changed', onAuthChanged);

    (function bootstrap(): void {
      currentUser = readCache();
      setInteractive();
      renderUserScore();
    })();

    fetchRating();

    (async () => {
      const menu = (window as any).__qimochiUserMenu;
      if (menu) {
        const u = menu.getUser();
        if ((u?.sub ?? null) !== (currentUser?.sub ?? null)) {
          currentUser = u ?? null;
          setInteractive();
          fetchRating();
        }
      }
    })();
  })();
</script>