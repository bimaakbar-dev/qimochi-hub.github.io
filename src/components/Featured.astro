---
import Badge from '~/user-components/Badge.astro';
import LinkButton from '~/user-components/LinkButton.astro';
import { URLS } from '~/constants';

interface AnimeItem {
  id: string;
  data: {
    title: string;
    cover: string;
    status: string;
    releaseDate: Date | null;
    rating: number;
  };
}

interface Props {
  items?: AnimeItem[];
}

const { items = [] } = Astro.props;

if (items.length === 0) return null;
---

<section class="hero-carousel" aria-label="Anime terbaru">
  <div class="hero-track">
    {items.map((anime, i) => (
      <article class="hero-slide">
        <div class="wrapper">
          <div class="hero-slide-inner">
            <div class="hero-text">
              <Badge variant="accent" mark>BARU</Badge>
              <h1 class="hero-title">{anime.data.title}</h1>
              <p class="hero-meta">
                {anime.data.status}
                {anime.data.releaseDate && (
                  <> · {anime.data.releaseDate.getFullYear()}</>
                )}
                {' · Rating '}{anime.data.rating}
              </p>
              <LinkButton
                href={URLS.anime(anime.id)}
                variant="accent"
                size="lg"
                icon="play"
              >
                Tonton
              </LinkButton>
            </div>

            <div class="hero-cover">
              <img
                src={anime.data.cover}
                alt={`Cover ${anime.data.title}`}
                width="300"
                height="450"
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : 'auto'}
                decoding="async"
              />
            </div>
          </div>
        </div>
      </article>
    ))}
  </div>

  <nav class="hero-dots" aria-label="Navigasi slide">
    {items.map((_, i) => (
      <button
        type="button"
        class:list={['hero-dot', { active: i === 0 }]}
        data-index={i}
        aria-label={`Slide ${i + 1}`}
      ></button>
    ))}
  </nav>
</section>

<script>
  const track = document.querySelector<HTMLElement>('.hero-track');
  const dots = document.querySelectorAll<HTMLButtonElement>('.hero-dot');

  if (track && dots.length > 0) {
    const slides = track.querySelectorAll<HTMLElement>('.hero-slide');

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const index = Array.from(slides).indexOf(entry.target as HTMLElement);
            dots.forEach((dot, i) => {
              dot.classList.toggle('active', i === index);
            });
          }
        });
      },
      { root: track, threshold: 0.6 }
    );

    slides.forEach((slide) => observer.observe(slide));

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const index = Number(dot.dataset.index);
        const target = slides[index];
        if (!target) return;

        track.scrollTo({
          left: target.offsetLeft,
          behavior: 'smooth',
        });
      });
    });
  }
</script>

<style>
  .hero-carousel {
    background: var(--bg-footer);
    overflow: hidden;
  }

  .hero-track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
  }

  .hero-track::-webkit-scrollbar {
    display: none;
  }

  .hero-slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
    min-width: 0;
  }

  .hero-slide-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-4);
    padding-block: var(--s-6) var(--s-5);
    align-items: center;
  }

  .hero-cover {
    order: -1;
    width: 100%;
    max-width: 200px;
    margin-inline: auto;
  }

  .hero-cover img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    aspect-ratio: 2 / 3;
    image-rendering: -webkit-optimize-contrast;
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    text-align: center;
    align-items: center;
    min-width: 0;
  }

  .hero-title {
    font-size: var(--fs-4xl);
    margin: 0;
    color: var(--text-inverted);
    line-height: var(--lh-tight);
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .hero-meta {
    color: var(--text-inverted);
    opacity: 0.75;
    font-size: var(--fs-base);
    line-height: var(--lh-relaxed);
    margin: 0;
  }

  .hero-dots {
    display: flex;
    justify-content: center;
    gap: var(--s-2);
    padding-block: var(--s-2) var(--s-5);
  }

  .hero-dot {
    width: 8px;
    height: 8px;
    padding: 0;
    border: none;
    background: var(--border);
    cursor: pointer;
    transition: background var(--t-fast), transform var(--t-fast);
  }

  .hero-dot:hover {
    background: var(--border-hover);
  }

  .hero-dot.active {
    background: var(--accent);
    transform: scale(1.3);
  }

  @media (min-width: 50rem) {
    .hero-slide-inner {
      grid-template-columns: 1.2fr 1fr;
      gap: var(--s-8);
      padding-block: var(--s-8) var(--s-6);
      min-height: 320px;
    }

    .hero-cover {
      order: 0;
      width: auto;
      max-width: none;
      justify-self: end;
      margin-inline: 0;
    }

    .hero-cover img {
      max-height: 280px;
      width: auto;
    }

    .hero-text {
      text-align: left;
      align-items: flex-start;
    }

    .hero-title {
      font-size: var(--fs-6xl);
    }
  }
</style>