---
import Icon from '~/user-components/Icons.astro';

interface Props {
  title: string;
  url?: string;
  class?: string;
}

const { title, url, class: className } = Astro.props;

const shareUrl = url ?? Astro.url.href;
---

<div class:list={['share-wrap', className]}>
  <button
    type="button"
    class="icon-action"
    data-share-btn
    data-title={title}
    data-url={shareUrl}
    aria-label="Bagikan"
    title="Bagikan"
  >
    <Icon name="share" size={18} />
  </button>

  <span
    class="share-toast"
    data-share-toast
    role="status"
    aria-live="polite"
    hidden
  >
    Link disalin
  </span>
</div>

<script>
  (function () {
    function init(btn: HTMLButtonElement): void {
      if (btn.dataset.bound === '1') return;
      btn.dataset.bound = '1';

      const wrap = btn.closest<HTMLElement>('.share-wrap');
      const toast = wrap?.querySelector<HTMLElement>('[data-share-toast]') ?? null;
      let toastTimer: number | null = null;

      function showToast(): void {
        if (!toast) return;
        toast.hidden = false;
        if (toastTimer !== null) window.clearTimeout(toastTimer);
        toastTimer = window.setTimeout(() => {
          toast.hidden = true;
          toastTimer = null;
        }, 2000);
      }

      btn.addEventListener('click', async () => {
        const title = btn.dataset.title ?? document.title;
        const url = btn.dataset.url ?? location.href;

        if (typeof navigator.share === 'function') {
          try {
            await navigator.share({ title, url });
            return;
          } catch {
            // user cancel atau tidak didukung — fallback ke copy
          }
        }

        try {
          await navigator.clipboard.writeText(url);
          showToast();
        } catch (err) {
          console.error('[share] copy failed', err);
        }
      });
    }

    document
      .querySelectorAll<HTMLButtonElement>('[data-share-btn]')
      .forEach(init);
  })();
</script>

<style>
  .share-wrap {
    position: relative;
    display: inline-flex;
  }

  .icon-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    background: transparent;
    color: var(--text-primary);
    border: 1px solid var(--border);
    border-radius: var(--r-full);
    cursor: pointer;
    transition: color var(--t-fast), border-color var(--t-fast);
  }

  .icon-action:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .icon-action :global(svg) {
    display: block;
    width: 18px;
    height: 18px;
  }

  .share-toast {
    position: absolute;
    top: calc(100% + var(--s-2));
    left: 50%;
    transform: translateX(-50%);
    padding: 4px var(--s-2);
    background: var(--text-primary);
    color: var(--bg-base);
    font-size: 0.6875rem;
    font-weight: var(--fw-medium);
    white-space: nowrap;
    border-radius: var(--r-sm);
    pointer-events: none;
    z-index: var(--z-overlay);
  }

  .share-toast[hidden] {
    display: none;
  }
</style>