---
import { getAllGenreEntries, getAnimeByGenreSlug, paginate } from '~/lib/genre';
import { PER_PAGE } from '~/constants';

import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/Hero.astro';
import AnimeCard from '~/components/AnimeCard.astro';
import Pagination from '~/components/Pagination.astro';
import Page from '~/components/Page.astro';

export async function getStaticPaths() {
  const genres = await getAllGenreEntries();
  const paths = [];

  for (const g of genres) {
    const anime = await getAnimeByGenreSlug(g.id);
    if (anime.length === 0) continue;

    const totalPages = Math.max(1, Math.ceil(anime.length / PER_PAGE));

    paths.push({
      params: { slug: g.id, page: undefined },
      props: { genre: g.name, slug: g.id, anime, totalPages, pageNumber: 1 },
    });

    for (let page = 2; page <= totalPages; page++) {
      paths.push({
        params: { slug: g.id, page: String(page) },
        props: { genre: g.name, slug: g.id, anime, totalPages, pageNumber: page },
      });
    }
  }

  return paths;
}

const { genre, slug, anime, totalPages, pageNumber } = Astro.props;
const items = paginate(anime, pageNumber);
const isFirstPage = pageNumber === 1;

const title = isFirstPage
  ? `Anime ${genre}`
  : `Anime ${genre} — Halaman ${pageNumber}`;

const description = isFirstPage
  ? `Koleksi ${anime.length} anime genre ${genre}.`
  : `${anime.length} anime · Halaman ${pageNumber} dari ${totalPages}`;
---

<BaseLayout
  title={title}
  description={description}
  canonical={`/anime/genre/${slug}/`}
  noindex={!isFirstPage}
>
  <Page class="wrapper">

    <Hero
      title={genre}
      description={description}
    />

    {items.length > 0 ? (
      <div class="anime-grid">
        {items.map(a => <AnimeCard anime={a} />)}
      </div>
    ) : (
      <p class="empty">Belum ada anime untuk genre ini.</p>
    )}

    <Pagination
      current={pageNumber}
      total={totalPages}
      base={`/anime/genre/${slug}`}
    />
  </Page>
</BaseLayout>

<style>
  .wrapper {
    padding-block: var(--s-6) var(--s-12);
    gap: var(--s-6);
  }
  .anime-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-3);
  }

  @media (min-width: 50rem) {
    .anime-grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: var(--s-4);
    }
  }
  .empty {
    color: var(--text-muted);
    text-align: center;
    padding: var(--s-12) 0;
    font-size: var(--fs-sm);
  }
</style>