---
import { getCollection } from 'astro:content';
import { getAllAnime } from '~/lib/anime';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/Hero.astro';
import LinkCard from '~/user-components/LinkCard.astro';
import { URLS } from '~/constants';

const [allAnime, allGenres] = await Promise.all([
  getAllAnime(),
  getCollection('genres'),
]);

const countMap = new Map<string, number>();
allAnime.forEach(a => {
  a.data.genres.forEach(slug => {
    countMap.set(slug, (countMap.get(slug) ?? 0) + 1);
  });
});

const categoryOrder = { genre: 0, theme: 1, demographic: 2 } as const;

const genres = allGenres
  .map(g => ({
    id: g.data.id,
    name: g.data.name,
    category: g.data.category,
    count: countMap.get(g.data.id) ?? 0,
  }))
  .filter(g => g.count > 0)
  .sort((a, b) => {
    const diff = categoryOrder[a.category] - categoryOrder[b.category];
    if (diff !== 0) return diff;
    return a.name.localeCompare(b.name, 'id-ID');
  });
---

<BaseLayout
  title="Semua Genre"
  description="Jelajahi anime berdasarkan genre."
  canonical="/anime/genre/"
>
  <div class="wrapper">

    <Hero
      title="Semua Genre"
      description={`${genres.length} genre · ${allAnime.length} anime`}
    />

    <div class="genre-grid">
      {genres.map(g => (
        <LinkCard
          href={URLS.genre(g.id)}
          variant="outline"
          padding="md"
        >
          <div class="genre-content">
            <span class="genre-name">{g.name}</span>
            <span class="genre-count">{g.count}</span>
          </div>
        </LinkCard>
      ))}
    </div>

  </div>
</BaseLayout>

<style>
  .wrapper {
    padding-block: var(--s-6) var(--s-12);
    gap: var(--s-6);
  }
  .genre-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-3);
  }

  @media (min-width: 48rem) {
    .genre-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--s-4);
    }
  }
  .genre-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    min-width: 0;
  }
  .genre-name {
    font-weight: var(--fw-semibold);
    color: var(--text-primary);
    font-size: var(--fs-base);
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .genre-count {
    font-size: var(--fs-xs);
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
  }
</style>