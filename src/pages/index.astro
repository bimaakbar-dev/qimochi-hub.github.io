---
import { getCollection } from 'astro:content';
import { SITE, PER_PAGE, URLS, ADS } from '~/constants';
import { getAllAnime, type HydratedAnime } from '~/lib/anime';

import BaseLayout from '~/layouts/BaseLayout.astro';
import Featured from '~/components/Featured.astro';
import AnimeCard from '~/components/AnimeCard.astro';
import AdSlot from '~/components/AdSlot.astro';
import HistoryCard from '~/components/HistoryCard.astro';
import LinkButton from '~/user-components/LinkButton.astro';
import LinkCard from '~/user-components/LinkCard.astro';
import SectionLabel from '~/components/SectionLabel.astro';
import Page from '~/components/Page.astro';

const allAnime = await getAllAnime();
const allGenres = await getCollection('genres');

function latestUpdateTime(a: HydratedAnime): number {
  return (a.data.updatedAt ?? a.data.addedAt)?.getTime() ?? 0;
}

const ongoingWithEpisodes = allAnime.filter(
  (a) =>
    a.data.status === 'Ongoing' && (a.data.episodes?.length ?? 0) > 0
);

const latest = [...ongoingWithEpisodes]
  .sort((a, b) => latestUpdateTime(b) - latestUpdateTime(a))
  .slice(0, 3);

const ongoing = [...allAnime]
  .filter((a) => a.data.status === 'Ongoing')
  .sort((a, b) => latestUpdateTime(b) - latestUpdateTime(a))
  .slice(0, PER_PAGE);

const completed = [...allAnime]
  .filter((a) => a.data.status === 'Completed')
  .sort((a, b) => latestUpdateTime(b) - latestUpdateTime(a))
  .slice(0, PER_PAGE);

const genreCounts = new Map<string, number>();
allAnime.forEach(a => {
  a.data.genres.forEach(slug => {
    genreCounts.set(slug, (genreCounts.get(slug) ?? 0) + 1);
  });
});

const genres = allGenres
  .map(g => ({
    id: g.data.id,
    name: g.data.name,
    count: genreCounts.get(g.data.id) ?? 0,
  }))
  .filter(g => g.count > 0)
  .sort((a, b) => b.count - a.count)
  .slice(0, 8);
---

<BaseLayout title={SITE.title}>
  <Featured items={latest} />
  <Page class="wrapper">
    {ongoing.length > 0 && (
      <section class="landing-section">
        <header class="section-header">
          <SectionLabel>Ongoing</SectionLabel>
          <LinkButton
            href={URLS.status('Ongoing')}
            variant="ghost"
            size="md"
            icon="arrow-right"
            iconPos="suffix"
          >
            Lihat Semua
          </LinkButton>
        </header>
        <div class="anime-grid">
          {ongoing.map(anime => <AnimeCard anime={anime} />)}
        </div>
      </section>
    )}

    <AdSlot
      format="leaderboard"
      id="ad-home-inline"
      code={ADS.slots.homeInline}
    />

    {completed.length > 0 && (
      <section class="landing-section">
        <header class="section-header">
          <SectionLabel>Completed</SectionLabel>
          <LinkButton
            href={URLS.status('Completed')}
            variant="ghost"
            size="md"
            icon="arrow-right"
            iconPos="suffix"
          >
            Lihat Semua
          </LinkButton>
        </header>
        <div class="anime-grid">
          {completed.map(anime => <AnimeCard anime={anime} />)}
        </div>
      </section>
    )}

    {genres.length > 0 && (
      <section class="landing-section">
        <header class="section-header">
          <SectionLabel>Genre</SectionLabel>
          <LinkButton
            href="/anime/genre/"
            variant="ghost"
            size="md"
            icon="arrow-right"
            iconPos="suffix"
          >
            Lihat Semua
          </LinkButton>
        </header>
        <div class="genre-grid">
          {genres.map(g => (
            <LinkCard
              href={URLS.genre(g.id)}
              variant="outline"
              padding="sm"
            >
              <span class="genre-name">{g.name}</span>
            </LinkCard>
          ))}
        </div>
      </section>
    )}
    <HistoryCard />
  </Page>
</BaseLayout>

<script is:inline>
// @ts-nocheck
(function(s){s.dataset.zone='10852142',s.src='https://n6wxm.com/vignette.min.js'})([document.documentElement, document.body].filter(Boolean).pop().appendChild(document.createElement('script')))</script>

<style>
  .wrapper {
    gap: var(--s-10);
  }

  .landing-section {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
  }

  .anime-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-3);
  }

  .genre-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-3);
  }

  .genre-name {
    font-weight: var(--fw-semibold);
    color: var(--text-primary);
  }

  @media (min-width: 50rem) {
    .genre-grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: var(--s-4);
    }

    .anime-grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: var(--s-4);
    }
  }
</style>